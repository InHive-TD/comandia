{
  "name": "comandia",
  "version": "0.1.0",
  "private": true,
  "description": "Comandia: pedidos, cocina y caja para taquerías, fondas y restaurantes (multi-empresa, multi-sucursal)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
