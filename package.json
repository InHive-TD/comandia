{
  "name": "comandia",
  "version": "0.1.0",
  "private": true,
  "description": "Comandia: pedidos, cocina y caja para taquerías, fondas y restaurantes (multi-empresa, multi-sucursal)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrar": "tsx --env-file=.env src/herramientas/migrar.ts",
    "crear-plataforma": "tsx --env-file=.env src/herramientas/crearPlataforma.ts",
    "plantilla": "tsx src/herramientas/plantilla.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
