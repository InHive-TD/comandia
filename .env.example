# Copia este archivo como .env y ajusta los valores. .env NUNCA se sube a GitHub.
PORT=3000
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=comandia
DB_USER=root
DB_PASSWORD=
ZONA_HORARIA=America/Mexico_City
# true si hay un proxy/CDN delante (Cloudflare, Nginx...) que manda X-Forwarded-*
CONFIAR_PROXY=false

# Correo saliente (invitaciones y restablecer contraseña). Buzón creado en Hostinger.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@comandia.mx
SMTP_PASS=
SMTP_FROM=Comandia <no-reply@comandia.mx>
# Dirección pública del sistema para los enlaces de los correos (staging o producción)
APP_URL=https://staging.comandia.mx
